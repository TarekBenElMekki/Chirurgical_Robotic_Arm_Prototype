<?xml version="1.0"?>
<package format="3">
  <name>surgical_arm_mouse_control</name>
  <version>0.1.0</version>
  <description>2D RViz mouse target IK control for the primitive surgical arm.</description>

  <maintainer email="master_thesis@example.com">master_thesis</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>interactive_markers</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
