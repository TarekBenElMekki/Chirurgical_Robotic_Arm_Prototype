<?xml version="1.0"?>
<package format="3">
  <name>surgical_arm_manual_mode</name>
  <version>0.1.0</version>
  <description>Standalone manual mode layer with floating mode selector, joystick/keyboard input, and RViz joint state simulation.</description>
  <maintainer email="master_thesis@example.com">master_thesis</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>