<?xml version="1.0"?>
<package format="3">
  <name>surgical_arm_perception</name>
  <version>0.4.0</version>
  <description>Camera, FSR sensing, and robot visualization tools for the surgical arm.</description>
  <maintainer email="benmekkitarek@gmail.com">Tarek Ben El Mekki</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>camera_ros</exec_depend>
  <exec_depend>surgical_arm_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
