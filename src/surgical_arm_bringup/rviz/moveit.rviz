Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: moveit_rviz_plugin/MotionPlanning
  Name: MotionPlanning
Visualization Manager:
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
  - Class: moveit_rviz_plugin/MotionPlanning
    Name: MotionPlanning
    Enabled: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: Pi Camera Feed
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /camera/image_raw
    Transport Hint: raw
  - Class: rviz_default_plugins/Marker
    Enabled: true
    Name: FSR Force Marker
    Marker Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /force/rviz_marker
    Namespaces:
      fsr_force: true
    Queue Size: 100
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
Window Geometry:
  Width: 1600
  Height: 900
