Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Displays:
  - Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Grid
  - Class: rviz_default_plugins/TF
    Enabled: true
    Name: TF
  - Class: rviz_default_plugins/RobotModel
    Enabled: true
    Name: RobotModel
    Description Source: Topic
    Description Topic:
      Value: /robot_description
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: Pi Camera Feed
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /camera/image_raw
    Transport Hint: raw
  - Class: rviz_default_plugins/Marker
    Enabled: true
    Name: FSR Force Marker
    Marker Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /force/rviz_marker
    Namespaces:
      fsr_force: true
    Queue Size: 100
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
Window Geometry:
  Width: 1400
  Height: 850
