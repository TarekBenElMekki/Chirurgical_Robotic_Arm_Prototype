<?xml version="1.0" encoding="UTF-8"?>
<robot name="surgical_arm">
  <group name="arm">
    <chain base_link="base_link" tip_link="distal_tool_link"/>
  </group>
  <group_state name="home" group="arm">
    <joint name="base_yaw_joint" value="0"/>
    <joint name="shoulder_pitch_joint" value="0"/>
    <joint name="elbow_pitch_joint" value="0"/>
    <joint name="arm_wrist_joint" value="0"/>
    <joint name="tool_roll_joint" value="0"/>
    <joint name="wrist_pitch_joint" value="0"/>
    <joint name="distal_tool_joint" value="0"/>
  </group_state>
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>
</robot>
