<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="surgical_arm">

  <xacro:arg name="use_mock_hardware" default="true"/>

  <link name="world"/>
  <link name="base_link">
    <visual><geometry><cylinder radius="0.08" length="0.06"/></geometry></visual>
  </link>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/><child link="base_link"/>
  </joint>

  <link name="shoulder_mount"><visual><geometry><cylinder radius="0.035" length="0.06"/></geometry></visual></link>
  <joint name="base_yaw_joint" type="revolute">
    <parent link="base_link"/><child link="shoulder_mount"/>
    <origin xyz="0 0 0.06"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.5"/>
  </joint>

  <link name="upper_arm_link"><visual><origin xyz="0.09 0 0"/><geometry><box size="0.18 0.05 0.04"/></geometry></visual></link>
  <joint name="shoulder_pitch_joint" type="revolute">
    <parent link="shoulder_mount"/><child link="upper_arm_link"/>
    <origin xyz="0 0 0.06"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.5"/>
  </joint>

  <link name="forearm_link"><visual><origin xyz="0.10 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.025" length="0.20"/></geometry></visual></link>
  <joint name="elbow_pitch_joint" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0.18 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="2.2" effort="10" velocity="1.8"/>
  </joint>

  <link name="arm_wrist_link"><visual><origin xyz="0.03 0 0"/><geometry><box size="0.06 0.05 0.05"/></geometry></visual></link>
  <joint name="arm_wrist_joint" type="revolute">
    <parent link="forearm_link"/><child link="arm_wrist_link"/>
    <origin xyz="0.17 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="8" velocity="2.0"/>
  </joint>

  <link name="roll_link"><visual><origin xyz="0.04 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.022" length="0.08"/></geometry></visual></link>
  <joint name="tool_roll_joint" type="revolute">
    <parent link="arm_wrist_link"/><child link="roll_link"/>
    <origin xyz="0.06 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="8" velocity="2.0"/>
  </joint>

  <link name="tool_body_link"><visual><origin xyz="0.045 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.015" length="0.09"/></geometry></visual></link>
  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="roll_link"/><child link="tool_body_link"/>
    <origin xyz="0.08 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="5" velocity="2.0"/>
  </joint>

  <link name="distal_tool_link"><visual><origin xyz="0.018 0 0"/><geometry><box size="0.036 0.022 0.018"/></geometry></visual></link>
  <joint name="distal_tool_joint" type="revolute">
    <parent link="tool_body_link"/><child link="distal_tool_link"/>
    <origin xyz="0.08 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-0.8" upper="0.8" effort="3" velocity="2.0"/>
  </joint>

  <ros2_control name="SurgicalArmSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>

    <joint name="base_yaw_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="shoulder_pitch_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="elbow_pitch_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="arm_wrist_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="tool_roll_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="wrist_pitch_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="distal_tool_joint"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
</robot>
