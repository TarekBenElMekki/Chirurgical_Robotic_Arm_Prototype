<?xml version="1.0"?>
<package format="3">
  <name>sg90_servo_control</name>
  <version>0.5.0</version>
  <description>Independent ROS 2 package for controlling an SG90 servo motor from Raspberry Pi GPIO using LGPIO.</description>
  <maintainer email="benmekkitarek@gmail.com">Tarek Ben El Mekki</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-lgpio</exec_depend>

  <exec_depend>control_msgs</exec_depend>

  <exec_depend>sensor_msgs</exec_depend>

  <exec_depend>trajectory_msgs</exec_depend>

  <exec_depend>surgical_arm_bringup</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
